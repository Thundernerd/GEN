# Copy to .env in the repository root (next to docker-compose.yml), or to
# /etc/gen/gen.env for the systemd unit, then fill in what you use.
# Every variable referenced as ${NAME} in gen.toml must be set.

# Optional GitHub token (a fine-grained token with no permissions is enough).
# Raises the GitHub API rate limit from 60 to 5000 requests per hour.
GITHUB_TOKEN=

# Admin token for switching sources on and off in the web UI (uncomment
# admin_token in gen.toml). Generate one with: openssl rand -hex 32
GEN_ADMIN_TOKEN=

# Optional: secrets for notification channels, referenced on the Notifications page
# as ${GEN_DISCORD_WEBHOOK} etc. instead of storing them in the database.

# Discord: Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL
GEN_DISCORD_WEBHOOK=

# ntfy: a long, hard-to-guess topic name; subscribe to it in the ntfy app.
GEN_NTFY_TOPIC=

# Apprise API: Apprise URLs to send to, when not using a saved configuration key.
GEN_APPRISE_URLS=

# SMTP login for email notifications.
GEN_SMTP_USER=
GEN_SMTP_PASSWORD=

# Log level (tracing EnvFilter syntax): info, debug, gen=debug, ...
RUST_LOG=info
